# Tamarin prover 1.12 + Maude, from the upstream Linux release.
# Debian trixie ships Maude 3.4, which is in Tamarin's supported range
# (bookworm's 3.2 is explicitly flagged as unsupported).
FROM debian:trixie-slim

ARG TAMARIN_VERSION=1.12.0

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        maude \
        graphviz \
        libgmp10 \
        libtinfo6 \
        zlib1g \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/tamarin \
    && curl -fsSL -o /tmp/tamarin.tar.gz \
        "https://github.com/tamarin-prover/tamarin-prover/releases/download/${TAMARIN_VERSION}/tamarin-prover-${TAMARIN_VERSION}-linux64-ubuntu.tar.gz" \
    && tar -xzf /tmp/tamarin.tar.gz -C /opt/tamarin \
    && BIN="$(find /opt/tamarin -type f -perm -u+x -name 'tamarin-prover*' | head -n 1)" \
    && test -n "$BIN" \
    && ln -sf "$BIN" /usr/local/bin/tamarin-prover \
    && rm -f /tmp/tamarin.tar.gz \
    && tamarin-prover --version

WORKDIR /work
ENTRYPOINT ["tamarin-prover"]
CMD ["--help"]
