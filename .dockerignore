# ==============================================================================
# Docker build context ignore — excludes large/cache directories
# that aren't needed for Kani formal verification
# ==============================================================================

# Rust build artifacts
target/
**/target/

# Lean build artifacts
.lake/
**/.lake/
*.olean
*.ilean

# Kani run logs
proofs/kani/results/

# CI and docs are not needed in tool images
.github/

# Git history
.git/
.gitattributes
.gitignore
.gitmodules

# Large binary test artifacts
*.exe
*.pdb
*.dll
*.so
*.dylib

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo

# Temp files
keystream_*.bin
golden_hash_*.txt