# ==============================================================================
# Docker build context ignore — excludes large/cache directories
# that aren't needed for Kani formal verification
# ==============================================================================

# Rust build artifacts
target/
**/target/

# Git history
.git/
.gitattributes
.gitignore
.gitmodules

# Large binary test artifacts
*.exe
*.pdb
*.dll
*.so
*.dylib

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo

# Temp files
keystream_*.bin
golden_hash_*.txt