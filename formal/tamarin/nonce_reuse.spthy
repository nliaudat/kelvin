/*
  Kelvin - nonce reuse in a chaos/XOR mode: EXPECTED ATTACK.

  Same orbital configuration and the same nonce for two messages, so both
  ciphertexts use the same keystream h(config, nonce). The second message is a
  known plaintext, which is enough to recover the first.

  Expected: lemma secret_m1 is falsified.

  This models the documented weakness (COMPLIANCE.md sections 3-4). It is not a
  proof about the Rust code; h is treated as an uninterpreted function.
*/

theory KelvinNonceReuse
begin

builtins: xor

functions: h/2

rule GenerateConfig:
  [ Fr(~cfg) ] --> [ !Config(~cfg) ]

rule GenerateSecret:
  [ Fr(~m1) ] --[ Secret(~m1) ]-> [ !SecretMsg(~m1) ]

rule EncryptSecret:
  [ !Config(cfg), !SecretMsg(m1) ]
  -->
  [ Out(m1 XOR h(cfg, 'n')) ]

rule EncryptKnown:
  [ !Config(cfg) ]
  -->
  [ Out('m2' XOR h(cfg, 'n')) ]

lemma secret_m1:
  "All x #i. Secret(x) @ i ==> not (Ex #j. K(x) @ j)"

end
