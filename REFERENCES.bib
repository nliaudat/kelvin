% ---- Formal Verification ----

@misc{apple2026corecrypto,
  author    = {{Apple Security Research}},
  title     = {Formal Verification of corecrypto for Post-Quantum
               Cryptography},
  year      = {2026},
  howpublished = {\url{https://security.apple.com/blog/formal-verification-corecrypto/}},
  note      = {Blueprint for Kelvin's formal verification strategy:
               proving functional equivalence of cryptographic
               implementations against mathematical specifications.
               Key innovations: (1) proving ARM64 assembly equivalent
               to C code, then C code equivalent to FIPS spec;
               (2) reusable Isabelle lemma libraries for scaling
               verification; (3) early bug detection in ML-DSA
               implementation. Kelvin adapts this blueprint for
               Rust + Kani: proving Fixed arithmetic, Vec3 ops,
               compute_accelerations, and Verlet integrator against
               mathematical specifications.}
}

@misc{apple2026corecrypto_repo,
